<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/dashboard_welcome_textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="25dp"
        android:layout_marginLeft="50px"
        android:layout_marginRight="50px"
        android:layout_marginTop="100dp"
        android:text="Bienvenu sur votre tableau de bord !"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/dashboard_description_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Commencez par selectionnez l'une des options ci-dessous :"
        android:layout_marginTop="20px"
        android:layout_marginLeft="50px"
        android:layout_marginRight="50px"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dashboard_welcome_textView" />

    <Button
        android:id="@+id/dashboard_grades_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mes notes"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/dashboard_math_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mathématiques"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dashboard_grades_button" />

    <Button
        android:id="@+id/dashboard_francais_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Français"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dashboard_math_button" />

    <Button
        android:id="@+id/dashboard_settings_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mon profil"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dashboard_francais_button" />
</androidx.constraintlayout.widget.ConstraintLayout>