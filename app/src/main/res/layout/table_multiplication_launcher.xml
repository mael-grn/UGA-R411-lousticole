<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="50dp">

    <TextView
        android:id="@+id/tabMultLaunch_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Choisir une table de multiplication"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:textSize="40dp"
        android:textColor="@color/black"
        app:layout_constraintTop_toTopOf="parent" />

    <NumberPicker
        android:id="@+id/tabMultLaunch_number_picker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tabMultLaunch_textview" />

    <Button
        android:id="@+id/tabMultLaunch_train_button"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:text="Entrainement"
        app:layout_constraintTop_toBottomOf="@+id/tabMultLaunch_number_picker" />

    <Button
        android:id="@+id/tabMultLaunch_graded_button"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:text="exercice noté"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tabMultLaunch_train_button" />

    <Button
        android:id="@+id/tabMultLaunch_help_button"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:text="aide"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tabMultLaunch_graded_button" />

    <Button
        android:id="@+id/tabMultLaunch_back_button"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:text="retour"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tabMultLaunch_help_button" />

</androidx.constraintlayout.widget.ConstraintLayout>